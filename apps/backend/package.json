  "devDependencies": {
    "@types/node": "^20.6.0",
    "@types/express": "^4.17.20",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/jest": "^29.5.5",
    "typescript": "^5.2.0",
    "tsx": "^3.14.0",
    "eslint": "^8.49.0",
    "prettier": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  }
