{
  "name": "@nexa-2030/backend",
  "version": "0.1.0",
  "description": "NEXA 2030 Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx src/seed.ts",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "prisma": "^5.3.1",
    "@prisma/client": "^5.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-apple": "^2.0.2",
    "redis": "^4.6.10",
    "socket.io": "^4.7.2",
    "aws-sdk": "^2.1500.0",
    "stripe": "^14.0.0",
    "sendgrid": "^8.0.0",
    "openai": "^4.11.1",
    "zod": "^3.22.4",
    "uuid": "^9.0.0",
    "date-fns": "^2.30.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.0.0",
    "express-async-errors": "^3.1.1",
